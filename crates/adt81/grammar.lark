// ADT'81, the language of the HBDS system: our grammar.
//
// The language is defined by the simplified BNF of the 1995 polycopié,
// pages 19 to 28, and by the code the polycopié quotes. This file is not
// that BNF: it accepts the same language, written for a parser, and cites
// the page wherever it departs from the print. docs/adt81.md tells how it
// was derived and why each choice was made.
//
// Lark syntax, Earley parsing. `just check-grammar` parses every program in
// crates/adt81/tests/corpus with it and fails if one parses two ways, or if the Rust
// parser in src/adt81, which follows this file rule for rule, builds
// another tree.
//
// Comment tags:
//   fix       the print is wrong at that place
//   gap       the print uses a rule it never defines; filled by analogy
//   listing   the polycopié's code uses a construct its BNF lacks
//   decision  the print leaves a choice open; docs/adt81.md, "Decisions"
//
// Two principles hold throughout. Expressions are untyped: the print splits
// them by type (integer, float, complex...), which only the declarations
// can tell. And a bare name is one rule, whatever it designates: a
// variable, a class, an object, an attribute or a link. Types and kinds are
// the checker's.
//
// What no rule here can write: statements nest 64 deep, and an
// expression's tree is at most 256 high (docs/adt81.md, "Decisions"). The
// Rust parser refuses the rest.

start: program | fragment

// Modules, page 19

program: module+

?module: main_program | procedure | function | coroutine | functor

// listing: the papers in the polycopié (pages 152 to 158) quote
// declarations and statements outside any module; this reads them.
fragment: fragment_item (";" fragment_item)*

?fragment_item: local_declaration | parameter_specification | statement

main_program: "PROGRAM"i module_name ";" locals externals body

procedure: "SUBROUTINE"i module_name formal_parameters ";" parameter_specifications locals externals body

// listing: pages 49-50 and 127-128 name the algorithm of a computed
// attribute after the attribute, FUNCTION "ARC"."LENGTH".
function: "FUNCTION"i (module_name | computed_attribute) formal_parameters "RETURNS"i type fuzziness ";" parameter_specifications locals externals body

// decision: the class and the attribute are string literals, as every
// listing writes them: a heading is read before anything runs. A computed
// name would also make FUNCTION "A" . p (x) read two ways, the attribute p
// with a parameter, or the attribute p(x).
computed_attribute: STRING "." STRING

// decision: a process class's BODY is a coroutine (page 112, figure 51:
// "the class PUMP ... BODY (coroutine)"), named by the class's string, as
// FUNCTION "ARC"."LENGTH" names a computed attribute's algorithm.
coroutine: "COROUTINE"i (module_name | process_class) formal_parameters ";" parameter_specifications locals externals body

process_class: STRING

// listing: page 76 names the prefix the functor applies to,
// FUNCTOR C'COUPLE(D).
functor: "FUNCTOR"i (name "'")? module_name formal_parameters "RETURNS"i functor_result ";" parameter_specifications locals externals body

module_name: name

formal_parameters: ("(" name ("," name)* ")")?

parameter_specifications: (parameter_specification ";")*

parameter_specification: name ("," name)* ":" parameter_type mode

parameter_type: scalar_type | array_type | list_type | compound_type

// Types, pages 20 and 21

scalar_type: type fuzziness

array_type: "SPARSE"i? shape "OF"i type fuzziness

// fix: page 20 lacks the | after MATRIX and a closing bracket in TENSOR; a
// handwritten note on the page adds both.
shape: "VECTOR"i ("[" bounds "]")?
    | "MATRIX"i ("[" bounds "," bounds "]")?
    | "TENSOR"i ("[" bounds "," bounds "," bounds ("," bounds)* "]")?

bounds: bound ":" bound

bound: integer_constant | name

list_type: "LIST"i ("OF"i type fuzziness)?

compound_type: "COMPOUND"i

type: numeric_type | "BOOLEAN"i | "CHARACTER"i | "STRING"i | adt_type

numeric_type: "LONG"i? ("INTEGER"i | "FLOAT"i | "COMPLEX"i | "GAUSS"i | "QUATERNION"i | "RATIONAL"i)

adt_type: "CLASS"i | "CATTRIBUTE"i | "CLINK"i
    | "OBJECT"i | "OATTRIBUTE"i | "OLINK"i
    | "HCLASS"i | "HATTRIBUTE"i | "HLINK"i
    | "EMBRYO"i | "PROTOTYPE"i | "STRUCTURE"i

mode: "IN"i | "INOUT"i | "OUT"i

fuzziness: "APPR"i? "PROB"i? "SUBJ"i? "MULT"i? | "FUZZY"i

// Declarations, page 20

locals: ("LOCAL"i (local_declaration ";")*)?

local_declaration: name ("," name)* ":" declared_type

// fix: page 20 makes the initial value or constant a "one of"; optional is
// meant.
declared_type: scalar_type (initial_value | constant_value)?
    | array_type initial_value?
    | list_type
    | compound_type

initial_value: "INIT"i constant

constant_value: "CONSTANTE"i "=" constant

externals: ("EXTERNAL"i (external ";")*)?

external: module_name ("," module_name)* ":" module_kind

module_kind: "PROGRAM"i | "SUBROUTINE"i | "COROUTINE"i
    | "FUNCTION"i "RETURNS"i type fuzziness
    | "FUNCTOR"i "RETURNS"i functor_result

functor_result: type fuzziness
    | "SPARSE"i? ("VECTOR"i | "MATRIX"i | "TENSOR"i) "OF"i type fuzziness
    | list_type
    | compound_type

// Statements, pages 21 to 25

body: "BEGIN"i statements "END"i ";"

statements: statement (";" statement)*

?statement: control | empty_statement | list_statement | adt_statement
    | process_statement | call | io | assignment | reset | result

control: loop | each_loop | vector_loop | parallel | if_statement
    | case_statement | loop_exit | module_exit | halt

loop: "LOOP"i ("FOR"i name ":" expression "TO"i expression ("STEP"i expression)?)? ("WHILE"i expression)? "DO"i statements ("UNTIL"i expression)? "ENDLOOP"i

// fix: what follows OF is a list expression (page 28's form), so that the /
// introducing the filter is never read as a division.
each_loop: "EACH"i name ("OF"i list_expression)? ("/" expression)? "DO"i statements "ENDEACH"i

vector_loop: "VECT"i "FOR"i name ":" expression "TO"i expression ("STEP"i expression)? "DO"i statements "ENDVECT"i

parallel: "PARBEGIN"i statements ("PAR"i statements)+ "ENDPAR"i

if_statement: "IF"i expression "THEN"i statements ("ELSE"i statements)? "ENDIF"i

case_statement: "CASE"i expression ("WHEN"i expression_list "DO"i statements)+ ("OTHERS"i statements)? "ENDCASE"i

// decision: the number of loops to leave is optional, one by default; page
// 22 always writes it.
loop_exit: ("EXIT"i | "NEXT"i | "RELOOP"i) expression?

module_exit: "RETURN"i | "REPROC"i

halt: "PAUSE"i | "STOP"i | "RESTART"i

empty_statement:

assignment: variable ":=" expression

reset: "RESET"i variable ("," variable)*

result: "RESULT"i expression

// fix: page 22 makes the position a "one of"; optional is meant.
list_statement: "INSERT"i list_expression ("," list_expression)* "INTO"i name (("AFTER"i | "BEFORE"i) expression)?
    | "EXTRACT"i list_expression ("," list_expression)* "OUTOF"i name
    | "EMPTY"i name
    | ("LINEAR"i | "CIRCULAR"i) name ("," name)*
    | ("SINGLE"i | "TUPLE"i) name ("," name)*

adt_statement: create | state_change | adt_assignment | assertion | specify
    | include | exclude | associate | dissociate | design | compose | build
    | modality

// Classes and objects share one list: with bare names they read alike, and
// the checker keeps the list homogeneous.
create: "CREATE"i (designation_list | class_attribute_list | class_link_declarations)

// fix: page 23 places the operand list twice, after the operation and
// inside it; once is meant.
state_change: ("HIBERN"i | "AWAKE"i | "DESTROY"i | "RESUR"i | "PURGE"i) (designation_list | class_attribute_list | class_link_list)

// listing: pages 49 and 51 design attributes and links of embryos as well
// as the embryos themselves.
design: "DESIGN"i (class_list | class_attribute_list | class_link_declarations)

class_link_declarations: class_link_declaration ("," class_link_declaration)*

class_link_declaration: class_link ("REVERSE"i adt_name | "REFLEXIVE"i)?

designation_list: designation ("," designation)*

class_list: class ("," class)*

class_attribute_list: class_attribute ("," class_attribute)*

class_link_list: class_link ("," class_link)*

// decision: a property of an a.d.t. is set with LET only (page 23, page
// 156); page 158 drops the LET.
// listing: page 156 sets properties such as COND and ACTION, A'COND := ...
adt_assignment: "LET"i (object_attribute | property) ":=" expression

property: adt "'" name

// fix: page 23's object link ends in an object name, which a handwritten
// note corrects to a link name. decision: the relationship is a string
// literal. listing: page 154 gives it a probability, % 0.80.
assertion: "ASSERT"i (object "NOT"i? STRING ("%" real)? object | name)

// gap: page 159 holds two objects to a link with MUST and CANNOT, which the
// BNF lacks; MAY, what a link between classes says (page 158), lifts
// either. decision: a standing modality per pair (docs/hbds.md).
modality: object ("MAY"i | "MUST"i | "CANNOT"i) STRING object

// fix: page 24 gives this rule the name of page 19's parameter
// specification. listing: page 49 writes a colon and COMPUTED, page 154
// specifies classes and links and fuzziness alone, page 158 adds a UNIT.
specify: "SPECIFY"i specified ("," specified)* ":"? specification ("UNIT"i "(" name ")")? "COMPUTED"i?

?specified: class | class_attribute | class_link

specification: type fuzziness
    | ("VECTOR"i | "MATRIX"i | "TENSOR"i) ("OF"i type fuzziness)?
    | list_type
    | compound_type
    | fuzziness

include: "INCLUDE"i class_list "INTO"i class_list

exclude: "EXCLUDE"i class_list "OUTOF"i class_list

// Page 24 pairs class parts with classes, object parts with objects, and
// objects with classes; with bare names the pairs read alike, so one rule
// per shape, and the pairing is the checker's.
associate: "ASSOC"i adt "WITH"i designation ("," adt "WITH"i designation)*

dissociate: "DISSOC"i adt "FROM"i designation ("," adt "FROM"i designation)*

compose: "COMPOSE"i class "WITH"i class_list

build: "BUILD"i class_list "AS"i class

// fix: page 25 has a stray bracket after AT, marked "pb" by hand.
process_statement: "ACTIVATE"i object
    | "REACTIVATE"i object ("AT"i expression | "BEFORE"i object | "AFTER"i object)?
    | "CANCEL"i object | "KILL"i object
    | "DELAY"i object "FOR"i expression | hold
    | "PASSIVATE"i | "TERMINATE"i

// listing: page 125 holds the current process with HOLD FOR dt; the BNF's
// object, page 25, is optional, and when given is the current process.
hold: "HOLD"i object? "FOR"i expression

call: "CHAIN"i module_name | "CALL"i invocation | "RESUME"i invocation

invocation: module_name ("(" expression_list ")")?

io: "READ"i variable ("," variable)* | "PRINT"i expression_list

// A.d.t. designations, pages 23 and 24

class: adt_name

class_attribute: class "." adt_name

// decision: a link's relationship is a string literal, never a computed
// string, so that three juxtaposed terms are a link only around a quoted
// name.
class_link: class STRING class

// fix: the brackets around an object's class are literal, as the code
// writes them, "P" [ "POINT" ].
object: name | adt_name "[" class "]" | "THIS"i

object_attribute: name | object "." adt_name

// An a.d.t. by its shape: whether a designation is a class or an object is
// the checker's.
designation: class | adt_name "[" class "]" | "THIS"i

// gap: page 27 uses an a.d.t. operand it never defines; page 29 expands
// the abbreviation as "abstract data type".
adt: designation | designation "." adt_name | designation STRING designation

// Constants, pages 25 and 26

constant: arithmetic_constant | boolean_constant | STRING

arithmetic_constant: integer_constant | float_constant | complex_constant
    | gauss_constant | quaternion_constant | rational_constant

// fix: page 26 makes the sign a "one of"; optional is meant.
integer_constant: sign? INTEGER

float_constant: sign? FLOAT

// decision: imaginary units are suffixes, 2.0i, where page 26 writes them
// as prefixes, i 2.0.
complex_constant: sign? FLOAT sign IMAG_FLOAT_I

gauss_constant: sign? INTEGER sign IMAG_INTEGER_I

quaternion_constant: sign? FLOAT sign IMAG_FLOAT_I sign IMAG_FLOAT_J sign IMAG_FLOAT_K

rational_constant: sign? INTEGER "//" INTEGER

sign: "+" | "-"

boolean_constant: "TRUE"i | "FALSE"i

// Expressions, pages 26 to 28, loosest operator first

?expression: disjunction

expression_list: expression ("," expression)*

?disjunction: conjunction (("OR"i | "NOR"i | "XOR"i) conjunction)*

// fix: page 27 joins exactly two terms with AND; any number is meant.
?conjunction: negation (("AND"i | "NAND"i) negation)*

?negation: "NOT"i negation | relation

// The object link of page 27 is a boolean: THIS "retro" a.
?relation: union
    | union comparator union
    | union ("IN"i | "NOTIN"i) union
    | object STRING object

// gap: page 27 uses a comparator it never lists.
comparator: "=" | "/=" | "<" | "<=" | ">" | ">="

?union: intersection ("UNION"i intersection)*

?intersection: complement ("INTER"i complement)*

// gap: page 28 leaves the right operand of COMPL undefined; a list term.
?complement: concatenation ("COMPL"i concatenation)?

?concatenation: sum ("&" sum)*

// listing: page 153 adds array operators, [+] [*] [.] [^].
?sum: sign? product (("+" | "-" | "[+]") product)*

// fix: page 26 has a - where / is meant among the float operators.
// decision: % is not an operator; integer division is /.
?product: power (("*" | "/" | "MOD"i | "//" | "[*]" | "[.]" | "[^]") power)*

?power: operand ("^" operand)?

?operand: fuzzy_number | STRING | boolean_constant
    | variable
    | function_call
    | "(" expression ")"
    | functor_expression
    | object_attribute_value
    | multiple
    | this

// decision: THIS is a value, the object it stands for (page 158 uses it
// only before a part, THIS."temp"), so that a process's body can print or
// hand on its process.
this: "THIS"i

// listing: pages 152 to 154 attach to a number an approximation (+-), a
// probability (%) and an opinion (@), in that order.
// decision: to a number literal only.
fuzzy_number: number ("+-" real)? ("%" real)? ("@" STRING)?

number: real | IMAG_INTEGER_I | IMAG_FLOAT_I | IMAG_FLOAT_J | IMAG_FLOAT_K

real: INTEGER | FLOAT

// listing: page 152, a value with several possibilities, { 25.3, 25.7 }.
multiple: "{" sign? fuzzy_number ("," sign? fuzzy_number)* "}"

// Without parentheses a call is a bare name, which `variable` reads.
function_call: module_name "(" expression_list ")"

// gap: pages 26 and 27 use an object attribute expression they never
// define; page 23's object attribute is meant.
object_attribute_value: object "." adt_name

// fix: page 27 also accepts a bare expression as the prefix, which would
// make a + b'F mean (a + b)'F; it is written in parentheses.
functor_expression: adt ("'" invocation)+

list_expression: list_union

list_union: list_intersection ("UNION"i list_intersection)*

list_intersection: list_complement ("INTER"i list_complement)*

list_complement: list_term ("COMPL"i list_term)?

list_term: variable | functor_expression | "(" expression ")"

// decision: page 23 names an a.d.t. by any string expression; here by one
// term, so that ' and . bind tighter than &, as postfix operators do:
// "A" & "B" ' F is "A" & ("B" ' F), a . "x" & "y" is (a . "x") & "y". And
// a bracket after a name in a designation is the class, p [ "C" ], as the
// print writes "P" [ "POINT" ]; an indexed name is written (T[i]).
// Parentheses give the other readings, and a functor result inside a
// designation, LET (a'F) . "x" ' COND := ...: otherwise a'F'G would read
// two ways.
adt_name: name | STRING | function_call | "(" expression ")"

variable: name ("[" expression_list "]")?

name: IDENT

// Lexical. Keywords are the words the print underlines, in any case.

// decision: the language is case-insensitive, names and keywords alike:
// opscrc and OPSCRC are one name (pages 50 and 127 write the same functor
// both ways), loop and LOOP the same keyword. For keywords this deviates
// from the print, which writes them in upper case only; deliberately, see
// docs/adt81.md. Keyword literals carry Lark's
// i flag; the lexer folds names, see fold_name.
IDENT: /[A-Za-z][A-Za-z0-9_]*/

INTEGER: /[0-9]+/

FLOAT: /[0-9]+\.[0-9]*/

IMAG_INTEGER_I: /[0-9]+i(?![A-Za-z0-9_])/
IMAG_FLOAT_I: /[0-9]+\.[0-9]*i(?![A-Za-z0-9_])/
IMAG_FLOAT_J: /[0-9]+\.[0-9]*j(?![A-Za-z0-9_])/
IMAG_FLOAT_K: /[0-9]+\.[0-9]*k(?![A-Za-z0-9_])/

// A string holds any character on one line, a quote written twice.
// decision: "" inside a string is a quote, as in Pascal and Ada, so that
// a COND can name an attribute: "THIS . ""temp"" > 0." (page 158).
STRING: /"(?:[^"\n]|"")*"/

// A comment runs from -- to the next -- on the same line (page 28).
COMMENT: /--[^\n]*?--/

%import common.WS
%ignore WS
%ignore COMMENT
