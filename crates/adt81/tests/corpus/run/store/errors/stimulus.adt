-- Figure 58 draws intensities above zero only: a neuron refuses a --
-- negative stimulus, which would take its LEVEL below zero. Written --
-- for the neural engine (docs/hbds.md, "Neurons"). --

program stimulus ;
begin
        create "valve" ; create "valve" . "pressure" ;
        create "v1" [ "valve" ] ;
        create "cell" ; include "cell" into "neuron" ;
        create "n" [ "cell" ] ;
        let "n" [ "cell" ] . "event" := "set" ;
        assoc "valve" . "pressure" with "n" [ "cell" ] ;
        let "n" [ "cell" ] ' reaction := "print ""fires""" ;
        let "v1" [ "valve" ] . "pressure" := 2 ;
        let "v1" [ "valve" ] . "pressure" := -3 ;
        print "never"
end ;
