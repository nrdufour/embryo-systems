-- A small schema: classes, embryos, a prototype, links and conditions. --

DESIGN "SOURCE", "STREAM", "CONFLUENCE" ;
DESIGN "STREAM" . "FLOW", "STREAM" . "LENGTH" ;
DESIGN "STREAM" "from" "SOURCE" REVERSE "feeds",
       "STREAM" "into" "CONFLUENCE" REVERSE "receives",
       "STREAM" "joins" "STREAM" REFLEXIVE ;
SPECIFY "STREAM" . "FLOW" : FLOAT APPR UNIT (m3s) ;
SPECIFY "STREAM" . "LENGTH" : FLOAT COMPUTED ;
COMPOSE "HYDROGRAPHY" WITH "SOURCE", "STREAM", "CONFLUENCE" ;
BUILD "ALPINE_RIVERS" AS "HYDROGRAPHY" ;
CREATE "Rhone" [ "STREAM" ] ;
LET "Rhone" [ "STREAM" ] . "FLOW" := 1700. +- 50. % 0.9 ;
ASSERT "Rhone" [ "STREAM" ] "into" % 0.99 "Lyon" [ "CONFLUENCE" ] ;
LET "STREAM" . "FLOW" ' COND := "THIS . FLOW >= 0." ;
LET "STREAM" "joins" "STREAM" ' ACTION := "PRINT THIS" ;
N := "Rhone" [ "STREAM" ] ' OPSC ' OFIN ' CARD ;
CREATE "RIVER" ; INCLUDE "RIVER" INTO "WATERWAY"
