-- multiplicity, and imaginary units as suffixes. --

T, P : FLOAT APPR PROB ;
R : FLOAT SUBJ ;
H : FLOAT MULT ;
Q : LONG QUATERNION APPR ;
V : SPARSE TENSOR OF COMPLEX APPR PROB SUBJ MULT INOUT ;
