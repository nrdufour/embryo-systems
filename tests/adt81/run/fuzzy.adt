-- Page 152's four aspects of fuzziness, each and combined, page 153's --
-- multiplicity, and a function's propagation: written for the --
-- interpreter's tests. Expected values computed apart, from the rules: --
-- approximations add worst-case, probabilities multiply, opinions join. --

PROGRAM VAGUE ;
LOCAL
        X, Y, Z : FLOAT APPR ;
        P, Q : FLOAT PROB ;
        S, T : FLOAT SUBJ ;
        M, N : FLOAT MULT ;
        W : FLOAT APPR PROB SUBJ ;
        R : FLOAT APPR ;
BEGIN
        X := 273.25 +- 0.22 ; Y := 122.34 +- 0.31 ;
        Z := X * Y ;
        PRINT Z ;
        Z := X + Y ;
        PRINT Z ;
        Z := X / Y ;
        PRINT Z ;
        P := 23.12 % 0.01 ; Q := 35.34 % 0.23 ;
        PRINT P + Q ;
        S := 31.45 @"doubtful" ; T := 12.87 @"not expected" ;
        PRINT S * T ;
        M := { 25.3, 25.7 } ; N := { 2.0, 3.0, 4.0 } ;
        PRINT M * N ;
        W := 25.3 +- 0.37 % 0.73 @"conform" ;
        PRINT W * (61.2 +- 0.22 % 0.69 @"unexpected") ;
        PRINT { 25.3 +- 0.37 % 0.73 @"conform", 25.7 +- 0.33 % 0.76 @"unexpected" }
            * { 34.5 +- 0.22 % 0.89 @"correct", 33.8 +- 0.23 % 0.87 @"a little weak" } ;
        R := SQRT(16.0 +- 0.8) ;
        PRINT R ;
        R := X ^ 2 ;
        PRINT R
END ;
